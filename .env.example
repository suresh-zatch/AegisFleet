# Google Gemini API Key (Required for live reasoning mode)
GEMINI_API_KEY=your-gemini-api-key-here

# APILayer Unified API Key
APILAYER_API_KEY=your-apilayer-api-key-here

# Google Cloud Settings
AEGISFLEET_GCP_PROJECT_ID=aegisfleet-demo
AEGISFLEET_GCP_REGION=us-central1
AEGISFLEET_SANDBOX_MODE=true
AEGISFLEET_LOG_LEVEL=INFO
